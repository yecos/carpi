// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

// ============================================
// CLIENTES
// ============================================
model Client {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  email           String?
  address         String?
  notes           String?
  active          Boolean  @default(true)
  archiiTenantId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quotations Quotation[]
}

// ============================================
// PROVEEDORES
// ============================================
model Supplier {
  id              String   @id @default(cuid())
  name            String
  contact         String?
  phone           String?
  email           String?
  address         String?
  active          Boolean  @default(true)
  archiiTenantId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  materials Material[]
}

// ============================================
// MATERIALES
// ============================================
enum MaterialCategory {
  TABLERO
  CANTO
  HERRAJE
  ACABADO
  MANO_OBRA
  OTRO
}

model Material {
  id              String           @id @default(cuid())
  name            String
  category        MaterialCategory
  unit            String
  price           Float
  supplierId      String?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  notes           String?
  active          Boolean          @default(true)
  archiiTenantId  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  priceUpdatedAt  DateTime?

  thickness       Float?
  width           Float?
  length          Float?
  color           String?
  materialType    String?

  furnitureComponents FurnitureComponent[]
  quotationItems     QuotationItem[]
}

// ============================================
// CATALOGO DE MOBILIARIO
// ============================================
enum FurnitureType {
  COCINA
  CLOSET
  BANO
  SALA
  OFICINA
  COMEDOR
  DORMITORIO
  OTRO
}

model FurnitureTemplate {
  id              String        @id @default(cuid())
  name            String
  type            FurnitureType
  description     String?
  image           String?
  active          Boolean       @default(true)
  archiiTenantId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  components     FurnitureComponent[]
  quotationItems QuotationItem[]
}

model FurnitureComponent {
  id               String           @id @default(cuid())
  templateId       String
  template         FurnitureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name             String
  quantity         Float
  widthFormula     String
  heightFormula    String
  depthFormula     String?
  materialCategory MaterialCategory  @default(TABLERO)
  materialId       String?
  material         Material?         @relation(fields: [materialId], references: [id])
  needsEdge        Boolean           @default(false)
  edgeSides        Int              @default(0)
  edgeType         String?
  hardwareList     String?
  laborHours       Float             @default(0)
  sortOrder        Int               @default(0)
}

// ============================================
// COTIZACIONES
// ============================================
model Quotation {
  id                String   @id @default(cuid())
  clientName        String
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id])
  project           String
  location          String?
  notes             String?
  subtotal          Float    @default(0)
  margin            Float    @default(25)
  total             Float    @default(0)
  status            String   @default("BORRADOR")
  archiiTenantId    String?
  archiiProjectId   String?
  archiiSyncedAt    DateTime?
  archiiWebhookId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items QuotationItem[]
}

model QuotationItem {
  id            String             @id @default(cuid())
  quotationId   String
  quotation     Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  templateId    String?
  template      FurnitureTemplate? @relation(fields: [templateId], references: [id])
  customName    String?
  width         Float
  height        Float
  depth         Float?
  quantity      Int      @default(1)
  materialId    String?
  material      Material? @relation(fields: [materialId], references: [id])
  materialType  String?
  finishType    String?
  subtotal      Float    @default(0)
  detail        String?
  sortOrder     Int      @default(0)
}
