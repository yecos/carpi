# ============================================
# Carpi - Cotizador de Carpintería
# ============================================
# Copia este archivo como .env y completa los valores

# Base de datos PostgreSQL (Neon)
# Obtén tu conexión en https://neon.tech
DATABASE_URL="postgresql://usuario:password@ep-xxx-xxx.us-east-2.aws.neon.tech/carpi?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxx-xxx.us-east-2.aws.neon.tech/carpi?sslmode=require"

# IA Vision (opcional - para análisis de fotos de muebles)
ZAI_API_KEY=""

# ============================================
# Firebase Auth (Shared with Archii)
# ============================================
# Obtén estos valores desde Firebase Console > Project Settings
# Estos son obligatorios para autenticación compartida con Archii
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ============================================
# Archii Integration
# ============================================
# URL de la API de Archii (default: https://archii-theta.vercel.app)
ARCHII_API_URL="https://archii-theta.vercel.app"
NEXT_PUBLIC_ARCHII_API_URL="https://archii-theta.vercel.app"

# Webhook secret para validar eventos entrantes de Archii (opcional)
ARCHII_WEBHOOK_SECRET=""
